{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mlab Movie Compressor",
  "version": "0.1.0",
  "identifier": "com.mimirraidlab.mlabmoviecompressor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Mlab Movie Compressor", "width": 760, "height": 800, "minWidth": 520, "minHeight": 670, "resizable": true }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline';" }
  },
  "bundle": { "active": true, "targets": "all", "copyright": "Copyright © 2026 mimirraid-lab" }
}
